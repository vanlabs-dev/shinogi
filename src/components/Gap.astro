---
const { text } = Astro.props;
---
<p class="gap"><span class="tag">Gap</span> {text}</p>

<style>
  .gap{margin:0;font-size:var(--size-s);color:var(--c-fg-2);display:flex;gap:var(--space-2);align-items:baseline;overflow-wrap:anywhere}
  .tag{flex:none;font-size:var(--size-xs);font-weight:650;text-transform:uppercase;letter-spacing:.08em;color:var(--c-fg-3);border:1px solid var(--c-line);border-radius:var(--radius-pill);padding:0 var(--space-2)}
</style>
