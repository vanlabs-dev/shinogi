---
// One public block: headline stats, charts, notes, rows or groups, gaps.
import Stat from "./Stat.astro";
import Chart from "./Chart.astro";
import Row from "./Row.astro";
import Gap from "./Gap.astro";
import Placeholder from "./Placeholder.astro";
import { noteList } from "../lib/flags.mjs";
const { block, section, flags = new Map(), skip = new Set() } = Astro.props;
const Title = block.title ? "h3" : null;
const facts = block.facts ?? [];
// Headline facts first, then the rest, in one grid so no card sits alone.
const ordered = [...facts.filter((f) => f.headline), ...facts.filter((f) => !f.headline)];
// A line series named "<fact id>-trend" draws inside that fact's tile.
const shown = (block.series ?? []).filter((s) => !skip.has(s.id));
const factIds = new Set(facts.map((f) => f.id));
const trendOf = (f) => shown.find((s) => s.kind === "line" && s.id === `${f.id}-trend`);
const lines = shown.filter((s) => s.kind === "line" && !factIds.has(s.id.replace(/-trend$/, "")));
const strips = shown.filter((s) => s.kind === "strip");
const listId = `${section}-${block.id}-rows`;
const tagsFor = (n) => flags.get(n) ?? [];
---
{block.access === "subscriber" ? (
  <Placeholder block={block} />
) : (
  <div class="block" data-block={block.id}>
    {Title && <Title>{block.title}</Title>}
    {ordered.length > 0 && <dl class="stats">{ordered.map((f) => <Stat fact={f} trend={trendOf(f)} />)}</dl>}
    {lines.length > 0 && <div class="charts">{lines.map((s) => <Chart series={s} />)}</div>}
    {strips.map((s) => <div class="card pad"><Chart series={s} /></div>)}
    {(block.notes ?? []).length > 0 && (
      <ul class="notes">{block.notes.map((t) => {
        const list = noteList(t);
        return list
          ? <li class="chips"><span class="k">{list.label}</span>{list.ids.map((n) => <span class="chip">SN{n}</span>)}</li>
          : <li>{t}</li>;
      })}</ul>
    )}
    {block.rows && block.rows.items.length > 0 && (
      <details class="fold card" open={block.rows.items.length <= 10}>
        <summary>{block.rows.label}</summary>
        {block.rows.sortable && (
          <div class="tools" data-sort-for={listId} hidden>
            <button type="button" data-order="doc" aria-pressed="true">As published</button>
            <button type="button" data-order="desc" aria-pressed="false">Largest first</button>
          </div>
        )}
        <ol class="rows" id={listId}>{block.rows.items.map((r, i) => <Row row={r} index={i} flags={tagsFor(r.netuid)} />)}</ol>
      </details>
    )}
    {(block.groups ?? []).length > 0 && (
      <div class="card">
        {block.groups.map((g) => (
          <div class="group">
            <h3 class="gl">{g.label}</h3>
            <ol class="rows">{g.rows.map((r, i) => <Row row={{ ...r, summary: r.name && g.label.startsWith(`${r.summary}:`) ? "" : r.summary }} index={i} flags={tagsFor(r.netuid)} />)}</ol>
          </div>
        ))}
      </div>
    )}
    {(block.gaps ?? []).map((t) => <Gap text={t} />)}
  </div>
)}

<style>
  .block{display:flex;flex-direction:column;gap:var(--space-3);min-width:0}
  h3{margin:0;font-size:var(--size-xs);text-transform:uppercase;letter-spacing:.1em;color:var(--c-fg-2);font-weight:650}
  .stats{margin:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-2)}
  @media (min-width:640px){.stats{grid-template-columns:repeat(auto-fit,minmax(10rem,1fr))}}
  .charts{display:grid;gap:var(--space-5);grid-template-columns:repeat(auto-fit,minmax(min(100%,18rem),1fr))}
  .card{background:var(--c-surface);border:1px solid var(--c-line);border-radius:var(--radius-s);padding:0 var(--space-4)}
  .card.pad{padding:var(--space-3) var(--space-4)}
  .rows>:global(li:last-child){border-bottom:0}
  .notes{margin:0;padding:0;list-style:none}
  .notes li{padding:var(--space-2) 0;border-top:1px solid var(--c-line);overflow-wrap:anywhere}
  .notes li:first-child{border-top:0}
  .chips{display:flex;flex-wrap:wrap;gap:var(--space-1);align-items:center}
  .chips .k{width:100%;font-size:var(--size-s);color:var(--c-fg-2);margin-bottom:2px}
  .chip{font-size:var(--size-s);font-variant-numeric:tabular-nums;padding:1px var(--space-2);border-radius:var(--radius-pill);background:var(--c-surface-2)}
  .fold>summary{cursor:pointer;min-height:var(--layout-target);display:flex;align-items:center;gap:var(--space-2);font-size:var(--size-s);font-weight:650;list-style:none}
  .fold>summary::-webkit-details-marker{display:none}
  .fold>summary::after{content:"Show";margin-left:auto;font-size:var(--size-s);color:var(--c-accent);font-weight:600}
  .fold[open]>summary::after{content:"Hide"}
  .fold>summary:focus-visible{outline:2px solid var(--c-accent);outline-offset:2px;border-radius:var(--radius-s)}
  .fold .rows{border-top:1px solid var(--c-line)}
  .rows{margin:0;padding:0}
  .group{padding:var(--space-3) 0}
  .group+.group{border-top:1px solid var(--c-line)}
  .gl{text-transform:none;letter-spacing:0;font-size:var(--size-s);color:var(--c-fg);font-weight:650}
  .tools[hidden]{display:none}
  .tools{display:flex;gap:var(--space-2);margin:var(--space-2) 0}
  .tools button{min-height:var(--layout-target);min-width:var(--layout-target);padding:0 var(--space-3);border-radius:var(--radius-pill);border:1px solid var(--c-line);background:var(--c-surface);color:var(--c-fg);font:inherit;font-size:var(--size-s);cursor:pointer}
  .tools button[aria-pressed="true"]{background:var(--c-fg);color:var(--c-bg);border-color:var(--c-fg)}
</style>
