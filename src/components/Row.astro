---
// One subnet, detail in place. Without detail it is a plain row, so no
// empty disclosure is offered. Tags name the note lists (flags.mjs) that
// include this subnet.
const { row, index, flags = [] } = Astro.props;
const who = row.name ? `${row.name}` : null;
---
<li class="row" data-i={index} data-sort={row.sort ?? ""}>
  {row.detail && row.detail.length ? (
    <details>
      <summary>
        <span class="uid">SN{row.netuid}</span>
        <span class="body">{who && <span class="nm">{who}</span>}{row.summary && <span class="sum">{row.summary}</span>}</span>
        <span class="end">{flags.map((f) => <span class={`tag ${f.tag}`} title={f.label}>{f.tag}</span>)}{row.figure && <span class="fig">{row.figure}</span>}</span>
      </summary>
      <dl class="detail">
        {row.detail.map((f) => (<div><dt>{f.label}</dt><dd>{f.text}{f.freshness && <span class="q"> {f.freshness}</span>}</dd></div>))}
      </dl>
    </details>
  ) : (
    <div class="line">
      <span class="uid">SN{row.netuid}</span>
      <span class="body">{who && <span class="nm">{who}</span>}{row.summary && <span class="sum">{row.summary}</span>}</span>
      <span class="end">{flags.map((f) => <span class={`tag ${f.tag}`} title={f.label}>{f.tag}</span>)}{row.figure && <span class="fig">{row.figure}</span>}</span>
    </div>
  )}
</li>

<style>
  .row{border-top:1px solid var(--c-line);list-style:none}
  .row:first-child{border-top:0}
  summary,.line{display:grid;grid-template-columns:3.75em 1fr auto;gap:var(--space-3);align-items:center;padding:var(--space-2) 0;font-size:var(--size-s)}
  summary{cursor:pointer;list-style:none;min-height:var(--layout-target);grid-template-columns:3.75em 1fr auto 1em}
  summary::-webkit-details-marker{display:none}
  summary::after{content:"+";grid-column:4;color:var(--c-fg-3);font-weight:600;width:1em;text-align:center}
  details[open] summary::after{content:"\2212"}
  summary:focus-visible{outline:2px solid var(--c-accent);outline-offset:2px;border-radius:var(--radius-s)}
  .uid{font-weight:650;font-variant-numeric:tabular-nums}
  .body{display:flex;flex-wrap:wrap;column-gap:var(--space-2);min-width:0}
  .nm{overflow-wrap:anywhere}
  .sum{color:var(--c-fg-3);overflow-wrap:anywhere}
  .end{display:flex;gap:var(--space-1);align-items:center;justify-content:flex-end}
  .fig{font-weight:650;font-variant-numeric:tabular-nums;margin-left:var(--space-1)}
  .tag{font-size:var(--size-xs);line-height:1.5;padding:0 var(--space-1);border-radius:4px;font-weight:600}
  .tag.dereg{background:var(--c-down);color:var(--c-surface)}
  .tag.owner{border:1px solid var(--c-accent);color:var(--c-accent)}
  .detail{margin:0 0 var(--space-3);padding:var(--space-3);background:var(--c-surface-2);border-radius:var(--radius-s);font-size:var(--size-s)}
  .detail dt{color:var(--c-fg-3);font-size:var(--size-xs);text-transform:uppercase;letter-spacing:.06em}
  .detail dd{margin:0 0 var(--space-2);overflow-wrap:anywhere}
  .q{color:var(--c-fg-3)}
</style>
