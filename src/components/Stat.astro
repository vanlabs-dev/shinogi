---
// Value, delta and date, all as written by Atlas. A trend series for the
// same fact, when Atlas records one, draws as a spark in the tile.
import Chart from "./Chart.astro";
const { fact, trend } = Astro.props;
const d = fact.delta;
---
<div class="stat">
  <dt>{fact.label}</dt>
  <dd>
    <span class="v">{fact.text}</span>
    {d && <span class={`d ${d.direction}`}>{d.text}</span>}
    {fact.freshness && <span class={`f${fact.stale ? " stale" : ""}`}>{fact.freshness}</span>}
    {trend && <Chart series={trend} spark />}
  </dd>
</div>

<style>
  .stat{background:var(--c-surface);border:1px solid var(--c-line);border-radius:var(--radius-s);padding:var(--space-3);min-width:0}
  dt{font-size:var(--size-xs);line-height:1.35;color:var(--c-fg-3);text-transform:uppercase;letter-spacing:.08em;font-weight:600}
  dd{margin:var(--space-1) 0 0;display:flex;flex-direction:column;gap:2px;min-width:0}
  .v{font-size:var(--size-stat);font-weight:680;letter-spacing:-.02em;line-height:1.15;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
  .d{font-size:var(--size-s);font-weight:600;font-variant-numeric:tabular-nums}
  .d.up{color:var(--c-up)} .d.down{color:var(--c-down)} .d.flat{color:var(--c-fg-2)}
  .f{font-size:var(--size-xs);color:var(--c-fg-3);overflow-wrap:break-word;hyphens:none}
  .f.stale{color:var(--c-down)}
</style>
