---
// The one view. Every figure comes from data/ as Atlas wrote it.
import path from "node:path";
import { loadData, asofLine, SECTIONS } from "../lib/load.mjs";
import { tokenCss } from "../styles/tokens.mjs";
import Section from "../components/Section.astro";
import SectionBar from "../components/SectionBar.astro";
import Chart from "../components/Chart.astro";
import { flagMap } from "../lib/flags.mjs";
import "../styles/base.css";

const dataDir = path.resolve(process.cwd(), process.env.SUBNT_DATA || "data");
const data = loadData(dataDir); // throws, and so fails the build, on bad data
const asof = asofLine(data);
const headline = data.empty
  ? "The page awaits the first Atlas publish. Every section names its missing input until then."
  : data.edition.headline ?? null;
// The lead mover's trend opens the page beside the headline; the movers
// section then skips it so it draws once.
const movers = data.sections.movers;
const heroSeries = movers?.access === "public"
  ? movers.blocks.filter((b) => b.access === "public")
      .flatMap((b) => b.series ?? []).find((s) => s.kind === "line") ?? null
  : null;
const skip = new Set(heroSeries ? [heroSeries.id] : []);
const flags = flagMap(data.sections);
const TAGLINE = "A lean read on Bittensor subnets";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>SUBNT · {TAGLINE}</title>
  <meta name="description" content={`${TAGLINE}. One page, every figure recorded by Atlas.`}>
  <meta name="color-scheme" content="light dark">
  <link rel="preload" href="/fonts/inter-latin-wght.woff2" as="font" type="font/woff2" crossorigin>
  <style is:inline set:html={tokenCss()}></style>
</head>
<body>
  <div class="wrap">
    <header class="mast">
      <h1>SUBNT</h1>
      <p class="tag">{TAGLINE}</p>
      <div class="asof">{asof
        ? <>Updated <time datetime={asof.iso} data-ago>{asof.time}</time> · block {asof.block}</>
        : "awaiting first Atlas publish"}</div>
    </header>
    <SectionBar sections={SECTIONS} />
    <main>
      {headline && (
        <div class="hero">
          <p class="headline">{headline}</p>
          {heroSeries && <Chart series={heroSeries} hero />}
        </div>
      )}
      {SECTIONS.map((s) => <Section meta={s} doc={data.sections[s.id]} flags={flags} skip={skip} />)}
    </main>
    <footer>
      <p>subnt.dev · public read-only</p>
    </footer>
  </div>
  <script is:inline>
    // Shows the edition's age in words, from the recorded compose time and
    // the reader's clock. The recorded time moves to the tooltip, in the
    // reader's own timezone.
    document.querySelectorAll("time[data-ago]").forEach(function (t) {
      var at = Date.parse(t.getAttribute("datetime"));
      if (isNaN(at)) return;
      t.title = new Date(at).toLocaleString();
      var n = function (k, w) { return k + " " + w + (k === 1 ? "" : "s"); };
      function tick() {
        var m = Math.max(0, Math.floor((Date.now() - at) / 60000));
        var d = Math.floor(m / 1440), h = Math.floor((m % 1440) / 60), mi = m % 60;
        t.textContent = m < 1 ? "just now"
          : d ? n(d, "day") + (h ? " and " + n(h, "hour") : "") + " ago"
          : h ? n(h, "hour") + (mi ? " and " + n(mi, "minute") : "") + " ago"
          : n(mi, "minute") + " ago";
      }
      tick();
      setInterval(tick, 60000);
    });
    // Reorders rows already in the document. Creates no figure, reads no
    // network. Without it the rows stay in published order.
    document.querySelectorAll("[data-sort-for]").forEach(function (tools) {
      var list = document.getElementById(tools.getAttribute("data-sort-for"));
      if (!list) return;
      tools.hidden = false;
      tools.addEventListener("click", function (e) {
        var b = e.target.closest("button");
        if (!b) return;
        var order = b.getAttribute("data-order");
        var rows = Array.prototype.slice.call(list.children);
        rows.sort(function (x, y) {
          if (order === "desc") {
            return Math.abs(+y.dataset.sort || 0) - Math.abs(+x.dataset.sort || 0);
          }
          return +x.dataset.i - +y.dataset.i;
        });
        rows.forEach(function (r) { list.appendChild(r); });
        tools.querySelectorAll("button").forEach(function (o) {
          o.setAttribute("aria-pressed", String(o === b));
        });
      });
    });
  </script>
</body>
</html>
